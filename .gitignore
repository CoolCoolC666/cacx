# ---- 数据与产物（不入库，用脚本重建）----
data/
*.db
*.db-wal
*.db-shm

# ---- 配置：settings.json 含本地路径与密钥，只提交模板 ----
config/settings.json
config/*.local.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 抓取缓存 ----
_cache/
*.log
_serve.err

# ---- 一次性临时脚本（调试用，跑完即弃）----
_tmp*.py
_tmp*.js
_probe.py

# 更通用的一条：单下划线前缀 = 本地自用的一次性脚本/核对工具。
# ⚠ 刻意写成 _[a-z0-9]* 而不是 _* —— 后者会把 cacx/__init__.py、
# cacx/__main__.py 一起忽略掉，包直接坏得莫名其妙。
_[a-z0-9]*.py
_[a-z0-9]*.js
_[a-z0-9]*.txt

# 例外：下面三个虽然带单下划线，但**不是**一次性探针，是工程证据，必须入库。
#   _rev_graph_limit.py  反向验证 —— 人为制造 5 个变异，证明 tests_graph_limit
#                         的断言真的能抓（抓不住 bug 等于没测）
#   _verify_demo_docs.py 演示断言核对 —— 把 docs/对接说明/04 里写的每个数字、
#                         每段原文，逐字对回运行中的服务，防止文档漂移
#   _verify_report.py     报告数字核对 —— 同上，对象是报告正文。
#                         首轮就跑出 3 处我写错的数（正文字数/分站篇数/长句计数），
#                         没有它这 3 处会直接交到老师手上。
#   _rev_autodemo.py     自动演示的反向验证 —— 10 个变异，
#                         实测「把判定改成永远为真」一个都抓不住（0/10），
#                         必须破坏**被观测的事实**才抓得住（8/8）。
#                         这条结论本身就是防踩坑的记录。
# 规则本身不放松，只给这几条开口子。
!（测试）/_rev_graph_limit.py
!（测试）/_verify_demo_docs.py
!（测试）/_verify_report.py
!（测试）/_rev_autodemo.py

# ---- 开发归档目录（测试脚本 + 开发期产物）----
# 测试脚本本身要入库；日志与截图不入库。
（测试）/_logs/
（测试）/截图/

# ---- 自动演示的产物 ----
# autodemo.py / run-demo.bat **入库**（演示要用），
# 但它跑出来的截图与录像不入库：可随时重跑生成，且体积不小。
（测试）/演示产物/
*.webm

# ---- pyvis 资源副本（派生物，不入库）----
# ⚠ 为什么可以挡：vis-network 的 js/css 由后端从 **pyvis 包内**读
#   （web/app.py: _pyvis_lib_dir()），项目根这个 lib/ 只是历史遗留副本。
#   导出件里的相对路径引用已在 pyvis_html() 里剥掉，所以导出 HTML
#   现在是真正的单文件 —— 不再需要这个目录。
lib/
（测试）/lib/

# ---- 中文名 bat 的旧版（cmd 按 GBK 解码，UTF-8 中文会碎成乱码）----
# 正式版是同名的英文名 .bat，见 README「一键启动」
启动cacx.bat
同步最新文章.bat
# ---- 自定义站点配置（json 模式下 headers 里可能带鉴权 token，同 settings.json 处理）----
config/sites.d/*.json

# ---- 组员数据包里的数据库（46 MB，派生物，可由 _export_pack.py 重新生成）
# 文档/CSV 照常入库，只有体积大的 db 挡掉
组员数据包/*.db
