# ---- 数据与产物（不入库，用脚本重建）----
data/
*.db
*.db-wal
*.db-shm

# ---- 配置：settings.json 含本地路径与密钥，只提交模板 ----
config/settings.json
config/*.local.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 抓取缓存 ----
_cache/
*.log

# ---- 一次性临时脚本（调试用，跑完即弃）----
_tmp*.py
_tmp*.js
_probe.py

# ---- 中文名 bat 的旧版（cmd 按 GBK 解码，UTF-8 中文会碎成乱码）----
# 正式版是同名的英文名 .bat，见 README「一键启动」
启动cacx.bat
同步最新文章.bat
# ---- 自定义站点配置（json 模式下 headers 里可能带鉴权 token，同 settings.json 处理）----
config/sites.d/*.json
