# ---- 一次性临时脚本（调试用，跑完即弃）----
_tmp*.py
_tmp*.js
_probe.py
# 临时试算产物（docx/json 等非脚本的中间件）；此前只有 .py/.js 两条，
# 导致 _tmp_试算2.docx 被 git add -A 顺手带进版本库
_tmp*.*

# 更通用的一条：单下划线前缀 = 本地自用的一次性脚本/核对工具。
# ⚠ 刻意写成 _[a-z0-9]* 而不是 _* —— 后者会把 cacx/__init__.py、
# cacx/__main__.py 一起忽略掉，包直接坏得莫名其妙。
_[a-z0-9]*.py
_[a-z0-9]*.js
_[a-z0-9]*.txt

# ⚠ 例外：以下三个必须入库，否则别人克隆下来跑不了。
#   上面 `_[a-z0-9]*.py` 会把它们一并忽略。三者的共同点：
#   **被 README / 别的入库文件当流程入口引用**，不是一次性脚本。
#   - _temppool.py  ：全部测试脚本的公共依赖，漏了 = 所有测试 ImportError
#   - _regress.py    ：README 里写明的全量回归入口（48 文件 / 765 项），
#                     还带着临时目录泄漏闸门；漏了 = 组员照 README 做会找不到文件
#   - _mutcheck_temppool.py ：泄漏闸门的反向验证（证明闸门会红），随闸门一起交付
!_temppool.py
!_regress.py
!_mutcheck_temppool.py
#   _repack.py：发布打包入口，docs/对接说明/05-R4 把它和 _accept_dist_pack.py
#   并列写成发版命令；漏掉 = 组员/同伴照文档做，第二步就找不到文件。
!_repack.py

# ---- 测试临时库落点（不该入库，且泄漏时要一眼看得见）----
# 临时库统一落这里而不是 %TEMP%：C 盘不涨，且泄漏能直接 dir 出来。
# 正常跑完回归后这个目录应当是空的 —— 非空就是泄漏，_regress.py 会判红。
（测试）/.tmp/

# 例外：下面三个虽然带单下划线，但**不是**一次性探针，是工程证据，必须入库。
#   _rev_graph_limit.py  反向验证 —— 人为制造 5 个变异，证明 tests_graph_limit
#                         的断言真的能抓（抓不住 bug 等于没测）
#   _verify_demo_docs.py 演示断言核对 —— 把 docs/对接说明/04 里写的每个数字、
#                         每段原文，逐字对回运行中的服务，防止文档漂移
#   _verify_report.py     报告数字核对 —— 同上，对象是报告正文。
#                         首轮就跑出 3 处我写错的数（正文字数/分站篇数/长句计数），
#                         没有它这 3 处会直接交到老师手上。
#   _rev_autodemo.py     自动演示的反向验证 —— 10 个变异，
#                         实测「把判定改成永远为真」一个都抓不住（0/10），
#                         必须破坏**被观测的事实**才抓得住（8/8）。
#                         这条结论本身就是防踩坑的记录。
# 规则本身不放松，只给这几条开口子。
!（测试）/_rev_graph_limit.py
!（测试）/_verify_demo_docs.py
!（测试）/_verify_report.py
!（测试）/_rev_autodemo.py
#   _cleanup_multicolumn.py  一文多栏目发的重复行清理（保守口径，可 --dry 重跑）。
#                         它记录的是**删行判断口径**本身 —— 同站+同标题+同 pub_day+
#                         正文指纹唯一 才算「确定同一篇」，其余一律不动。
#                         这是决策证据，丢了就没人能解释当时为什么只删 103 行、
#                         放过另外 11 组。脚本内含「连错库防护」，
#                         跑之前会打印库路径与 articles 总数。
#   _mutcheck_batch_dedup.py 反向验证 —— 去掉两个测试文件里的「正文唯一后缀」，
#                         让正文指纹守卫重新生效，断言测试必须红；
#                         还原后必须绿，且文件逐字节还原。
#                         守的是「守卫上线后，测试造数据不再是中立的」这条纪律。
!（测试）/_cleanup_multicolumn.py
!（测试）/_mutcheck_batch_dedup.py
#   _export_pack.py  **组员数据包的生成脚本**。这一版是重写复原的 ——
#                         起因就是上一版没入库、被「一次性脚本」清理掉了，
#                         于是 10-13 只能拿旧产物反推规则：栏目清单 25/25 靠逐行比对，
#                         联合发文口径靠 7 栏目 × 2 窗口穷举到 14/14 才钉死，
#                         而「疑似联合机关」那一列的原正则**彻底复原不了**。
#                         生成脚本丢了 = 口径永久丢失，这个代价已经付过一次了。
#                         ⚠ 同类「能重建交付物的脚本」一律入库，别只留产物。
!（测试）/_export_pack.py
#   _accept_dist_pack.py  **分发版验收闸** —— 把最新的 zip 解压到临时目录、
#                         用 8791 端口独立起一个服务，验「组员拿到手到底能不能跑、
#                         README 里念的数跟他自己打开网页看到的对不对」。
#                         _repack.py 那三道闸只能证明"我按计划拷了文件"，
#                         证明不了 zip 完整、也证明不了包内库/文档/服务三者自洽。
!（测试）/_accept_dist_pack.py
#   _verify_pack_matches_src.py 分发包 vs 源码一致性 —— 补的是一道**一直没人验**的闸：
#                         _repack 验「包完整吗」、_accept 验「解包后跑得起来吗」，
#                         但没有任何一处验「包里那份代码 == 我刚提交的那份」。
#                         以前出过「说明写 4416、库里还是 4515」的各说各话，同一类。
#                         ⚠ 排除规则**直接从 _repack.py 里抽出它的 skip() 来执行**，
#                           不另抄一份 —— 抄的那两版分别漏了目录级排除（假警报）
#                           和把 __init__.py 当本地脚本跳过（假阴性）。
#                         ⚠ 比对前先归一换行符：core.autocrlf 开着，工作区 CRLF、
#                           git blob 与包内 LF，不归一会把 18 个 \r 报成「代码不一样」。
!（测试）/_verify_pack_matches_src.py
#   _verify_datapack.py  组员数据包的交付前核对闸 —— 核的是**产物本身**：
#                         库的列/索引/空值分布、CSV 行数与表头、两级联合口径重算、
#                         以及 字段说明.md 承诺的每个数字是否真在数据里。
#                         上一版就出过「说明写 4416、库里还是 4515」的文档与数据各说各话。
#                         ⚠ 改完 _export_pack.py 必须两个一起跑才算改完。
!（测试）/_verify_datapack.py
#   _mutcheck_group_field.py 反向验证 —— 把 to_pyvis 里「给节点定 group」那三行
#                         换成不发 group（也就是本 bug 的原始形态），断言
#                         tests_graph_nodetype 必须红；还原后必须绿、文件逐字节还原。
#                         为什么值得单独守：这个 bug 已经上线很久了，它能活下来
#                         只因为**没有任何测试断言过 group**。
!（测试）/_mutcheck_group_field.py
#   _mutcheck_trunc.py 反向验证 —— 把 core.sort 的第二判据、edges 的定序
#                      分别拆掉，断言 tests_graph_trunc 必须红；还原后必须绿、
#                      且 graph_analysis.py 的 sha256 必须一致。
#                      同属「没有测试断言过 → bug 能一直活着」那一类：
#                      这个 bug 让同一张图报出 1407 / 1416 两个边数，
#                      而报告里引的是 1407、页面上显示 1416，两边都不报错。
!（测试）/_mutcheck_trunc.py
#   _mutcheck_hl.py（R4）反向验证 —— 把图谱点击聚焦 hl 的命中判定拆成恒假、
#                      把导出件的 hl 识别去掉，断言 tests_graph_hl 必须红；
#                      还原后必须绿、且 graph_analysis.py 的 sha256 一致。
#                      守的是「点了要变色」与「屏幕 = 导出」两条。
!（测试）/_mutcheck_hl.py
#   _mutcheck_hl_edge.py 反向验证 —— 把 hl 的**边判定**退化成 find 的
#                      「两端都命中」，断言 tests_graph_hl 必须红。
#                      单独存在的原因：豆包那两个变异只拆了节点判定与导出，
#                      没碰边语义。而边语义正是 R4 文档 §3.2 点名的坑
#                      （点单节点时若按「两端都命中」，边命中数 = 0，
#                       图上只有一个黄点、四周全暗 = 点了等于没反应）。
#                      没这条的话，那个坑正好从变异覆盖的缝里溜过去。
!（测试）/_mutcheck_hl_edge.py
#   _mutcheck_zoom.py 反向验证 —— 三条：
#     M1 把「图例还没渲染时按默认类型兜底」拆成 lgOn，
#        断言首屏兜底那条测试会红。这守的是**今天实测到的真 bug**：
#        首屏那次请求里图例一个 checkbox 都还没渲染，lgOn 为空，
#        `if(lgSend.length && ...)` 整个短路，notInit 挂在第二个条件上
#        根本没机会被读到，首屏按旧口径 1633/3921 建图（而页面显示 1759/4154）。
#     M2 把「等物理收敛后 fit」改成建图后立刻 fit。
#     M3 把实体类型变量改回 types —— 与上面「关系类型」那节撞名，
#        是 SyntaxError，**整个 script 不执行**，页面永远停在「加载中…」，
#        图谱请求一个都不发。这种错要往下滑控制台才看得到，现场几乎无法定位。
#   没这三条的话，上面两个坑都会从变异覆盖的缝里溜过去。
!（测试）/_mutcheck_zoom.py

# .bat 编码闸门：非 ASCII 或裸 LF 一律 FAIL。
#   本机实测：.bat 正文含 UTF-8 中文时，cmd.exe 按 OEM 代码页(GBK)解码会把
#   那行从中间截断，`python -m cacx serve` 根本不执行，而且**不报错**，
#   表现就是「双击了没反应」。纯 ASCII 是唯一可靠写法。
#   2026-10-16 当天我就差点往 start-cacx.bat 里写中文文件名，所以固化成闸门。
!（测试）/_fix_bat_crlf.py

# 报告取数与字数脚本（2026-10-16 报告重写时新增）：
#   _t10_report_stats.py —— 报告里 §3.1/§3.2/§3.3/§3.4 与 §五 每一个数字
#     的来源。只读连接，口径 = 2024+ 分析窗。入庫是因为本项目的原则是
#     「结果永远一致、可当场重跑」：报告数字若没有可重跑的取数脚本，
#     就只剩一句断言，下次没人能验证它是实测还是估的。
#   _wordcount.py / _wordsec.py —— 报告 1500–2500 字要求的口径工具。
#     前者一次报三种口径（中文字符 / 中文+英文数字词 / 全部非空白字符），
#     因为「字数」到底算不算标点从来没定过，口径不显式就会来回扯；
#     后者按段落报重量分布，精简时用来定点下刀。
!（测试）/_t10_report_stats.py
!（测试）/_wordcount.py
!（测试）/_wordsec.py

# 演示脚本取数（2026-10-16 丙方案）：
#   _t10_demo_rows.py —— 一次算出演示要念的每个数：边列表行号、画布口径、
#     两条演示边的证据首条。**行号尤其要靠它重算**：它随数据变，
#     脚本里记的行号一旦过期，台上按行号找就会找不到那条边。
!（测试）/_t10_demo_rows.py

